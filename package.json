{
  "name": "agi-chat-fix",
  "displayName": "AGI Chat Fix",
  "description": "Fixes Cmd+C / Cmd+V not working and restores right-click context menu in Antigravity chat panel.",
  "version": "1.0.0",
  "publisher": "dangphuc2470",
  "author": {
    "name": "dangphuc2470",
    "email": "dangnguyenhoangphuc1@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dangphuc2470/agi-chat-fix.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agi-chat-fix.apply",
        "category": "AGI Chat Fix",
        "title": "Apply Patch & Fix Checksums"
      },
      {
        "command": "agi-chat-fix.remove",
        "category": "AGI Chat Fix",
        "title": "Remove Patch (Restore Original)"
      },
      {
        "command": "agi-chat-fix.fixChecksums",
        "category": "AGI Chat Fix",
        "title": "Dismiss Corrupted Warning (Sync Checksums)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx -y @vscode/vsce package --no-dependencies --allow-star-activation"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.9.3"
  }
}